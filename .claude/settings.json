{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/heartbeat.sh start", "timeout": 10 }] }],
    "Stop":         [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/heartbeat.sh success", "timeout": 10 }] }],
    "StopFailure":  [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/heartbeat.sh failure", "timeout": 10 }] }]
  }
}
